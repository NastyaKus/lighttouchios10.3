+/* Optional, cumulative ABI. A read never consumes FPS counters. All times are ns.
+ * Histogram bins are 1 ms wide, final bin includes everything >=127 ms.
+ * main_cpu_ns samples CLOCK_THREAD_CPUTIME_ID on the QEMU main loop, not vCPUs.
+ */
+typedef struct InfernoDisplayMetricsV1 {
+    uint32_t version, size;
+    uint64_t presents, refreshes, pixman_cpu_ns, copy_cpu_ns, copy_wait_ns;
+    uint64_t copy_bytes, main_cpu_ns, gap_count, gap_sum_ns, gap_max_ns;
+    uint64_t gap_hist[128];
+} InfernoDisplayMetricsV1;
+bool inferno_display_metrics_read_v1(InfernoDisplayMetricsV1 *out, size_t size);
+void inferno_display_note_pixman_cpu(uint64_t ns);
+
 /*
  * A touch at an absolute position in framebuffer pixels — the emulated panel
  * wants the finger where it is, not a cursor moved towards it.
diff --git a/ui/inferno-embed.c b/ui/inferno-embed.c
index f826b1f..b5fc569 100644
--- a/ui/inferno-embed.c
+++ b/ui/inferno-embed.c
@@ -61,6 +61,33 @@ static int64_t  inferno_last_present_ns;
 static int64_t  inferno_gap_min_ns, inferno_gap_max_ns, inferno_gap_sum_ns;
 static uint64_t inferno_gap_count;
 
+/* qatomic counters also cover pixman before the display listener attaches. */
+static InfernoDisplayMetricsV1 metrics;
+static uint64_t main_cpu_start;
+static uint64_t metric_last_present;
+static uint64_t cpu_ns(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+}
+static void sample_main_cpu(void) {
+    if (main_cpu_start) qatomic_set(&metrics.main_cpu_ns, cpu_ns() - main_cpu_start);
+}
+void inferno_display_note_pixman_cpu(uint64_t ns) {
+    qatomic_add(&metrics.pixman_cpu_ns, ns);
+}
+bool inferno_display_metrics_read_v1(InfernoDisplayMetricsV1 *out, size_t size) {
+    if (!out || size < sizeof(*out)) return false;
+    out->version = 1; out->size = sizeof(*out);
+#define SNAP(field) out->field = qatomic_read(&metrics.field)
+    SNAP(presents); SNAP(refreshes); SNAP(pixman_cpu_ns); SNAP(copy_cpu_ns);
+    SNAP(copy_wait_ns); SNAP(copy_bytes); SNAP(main_cpu_ns); SNAP(gap_count);
+    SNAP(gap_sum_ns); SNAP(gap_max_ns);
+    for (int i=0; i<128; i++) out->gap_hist[i] = qatomic_read(&metrics.gap_hist[i]);
+#undef SNAP
+    return true;
+}
